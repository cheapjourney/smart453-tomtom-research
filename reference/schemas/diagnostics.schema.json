{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostics row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "request_id",
    "definition_file",
    "definition_sha256",
    "request_name",
    "service_id",
    "request_payload",
    "access_type",
    "evidence_level",
    "evidence_status",
    "source_id"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 3
    },
    "definition_file": {
      "type": "string"
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_name": {
      "type": "string"
    },
    "service_id": {
      "type": "string",
      "pattern": "^0x[0-9A-Fa-f]{2}$"
    },
    "request_payload": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]*$"
    },
    "access_type": {
      "type": "string",
      "enum": [
        "READ",
        "WRITE",
        "IO_CONTROL",
        "ROUTINE",
        "SESSION",
        "RESET",
        "CLEAR_DTC",
        "COMM_CONTROL",
        "KEEPALIVE",
        "UNKNOWN"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "UNCONFIRMED",
        "CONTRADICTED",
        "NOT_TESTED",
        "NOT_APPLICABLE"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "risks": {
      "type": "string"
    }
  }
}
