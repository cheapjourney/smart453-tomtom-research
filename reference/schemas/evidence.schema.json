{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "ecu_id",
          "level",
          "status",
          "statement",
          "scope",
          "source_ids",
          "public_safe"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "ecu_id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "UNCONFIRMED",
              "CONTRADICTED",
              "NOT_TESTED",
              "NOT_APPLICABLE"
            ]
          },
          "statement": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "artifact": {
            "type": "string"
          },
          "measured_at": {
            "type": "string"
          },
          "raw_archive": {
            "type": "string"
          },
          "public_safe": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
