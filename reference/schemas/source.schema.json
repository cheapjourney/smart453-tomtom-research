{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "type",
          "title",
          "retrieved",
          "locator",
          "public_safe"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "published": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "locator_internal": {
            "type": "string"
          },
          "public_safe": {
            "type": "boolean"
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
